{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "메아리: Chrome에서 디버깅",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "메아리: 개발 서버 실행"
    },
    {
      "name": "메아리: Next.js 전체 디버깅",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}
