{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "메아리: 개발 서버 실행",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^(.*)$", "file": 1, "location": 1, "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*next dev.*",
          "endsPattern": ".*(Ready in|Local:).*"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "메아리: 타입 검사",
      "type": "npm",
      "script": "lint",
      "problemMatcher": "$tsc"
    },
    {
      "label": "메아리: 프로덕션 빌드",
      "type": "npm",
      "script": "build",
      "problemMatcher": "$tsc"
    }
  ]
}
